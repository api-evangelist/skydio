{
  "opencollection": "1.0.0",
  "info": {
    "name": "Skydio Cloud Flights API",
    "version": "0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Flights",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List flights",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.skydio.com/api/v0/flights",
            "params": [
              {
                "name": "vehicle_serial",
                "value": "",
                "type": "query",
                "description": "Filter flights by vehicle serial number."
              }
            ]
          },
          "docs": "Retrieve flights, optionally filtered by vehicle."
        }
      ]
    }
  ],
  "bundled": true
}